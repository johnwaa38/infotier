PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-unique-password
DASHBOARD_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@db:5432/infotier?schema=public

# Free demo mode. Files are ephemeral and disappear when the service restarts.
LOCAL_STORAGE_PATH=/tmp/infotier-evidence

# Redis (optional)
REDIS_HOST=redis
REDIS_PORT=6379

# Providers
USE_GOOGLE_VISION=false
GOOGLE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/app/keys/gvision.json
USE_AZURE_FACE=false
AZURE_FACE_ENDPOINT=
AZURE_FACE_KEY=

# Webhook
WEBHOOK_SECRET=please-change-this-to-a-long-random-string

# Customer-owned verification provider. Infotier stores references and outcomes, not ID documents.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
